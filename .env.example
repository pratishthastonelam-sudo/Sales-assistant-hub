# ─────────────────────────────────────────────
#  Sales Assistant Hub — Environment Variables
# ─────────────────────────────────────────────

# --- React Frontend (Vite) ---
# Find these in your Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# The deployed URL of your process_chat_query Edge Function
# (or http://localhost:54321/functions/v1/process_chat_query for local dev)
VITE_EDGE_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/process_chat_query

# --- Supabase Edge Function (set via `supabase secrets set`) ---
# Do NOT put these in this .env file for production — use:
#   supabase secrets set GOOGLE_DRIVE_FOLDER_ID=xxx
#   supabase secrets set GOOGLE_SERVICE_ACCOUNT_JSON='...'
#   supabase secrets set GEMINI_API_KEY=xxx
#
# For local dev with `supabase functions serve`, create supabase/.env:
#   GOOGLE_DRIVE_FOLDER_ID=your_112gb_folder_id
#   GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#   GEMINI_API_KEY=your_gemini_api_key
#   SUPABASE_URL=https://your-project-ref.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Drive folder to search (the 112 GB folder)
GOOGLE_DRIVE_FOLDER_ID=your_112gb_folder_id

# Google Service Account JSON (entire JSON as a string)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# LLM API key (Google Gemini recommended for free-tier)
GEMINI_API_KEY=your_gemini_api_key

# WhatsApp Business API verification token (for webhook setup later)
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token

# Supabase service role key (for writing chat_sessions from the function)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
